{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "mint",
  "name": "Rastro",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#F59E0B",
    "light": "#FBBF24",
    "dark": "#D97706"
  },
  "background": {
    "decoration": "gradient"
  },
  "topbarCtaButton": {
    "name": "Dashboard",
    "url": "https://dashboard.rastro.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["introduction", "quickstart", "authentication"]
      },
      {
        "group": "Enrich API",
        "pages": ["enrich/quickstart", "enrich/reference", "enrich/examples"]
      },
      {
        "group": "Flows",
        "pages": ["flows/quickstart", "flows/reference", "flows/examples"]
      },
      {
        "group": "Catalogs",
        "pages": ["catalogs/quickstart", "catalogs/reference", "catalogs/examples"]
      },
      {
        "group": "Complete API Reference",
        "openapi": {
          "source": "api-reference/openapi.json",
          "directory": "api-reference"
        },
        "pages": ["api-reference/overview"]
      },
      {
        "group": "MCP (Codex / Claude)",
        "pages": ["mcp/quickstart", "mcp/reference"]
      },
      {
        "group": "Enterprise",
        "pages": ["integrations"]
      }
    ]
  },
  "api": {
    "baseUrl": "https://catalogapi.rastro.ai/api",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "mode": "show"
    },
    "request": {
      "example": {
        "languages": ["bash", "python", "javascript"]
      }
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
